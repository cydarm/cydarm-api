### Fix schema issues

# LogLevel is annotated as an integer but the API returns a string
.components.schemas.LogLevel.type = "string" |
del(.components.schemas.LogLevel.format) |

### OperationId fields for:
# event-trigger
.paths."/v0.9/event-trigger".get.operationId = "GetEventTriggers" |
.paths."/v0.9/event-trigger/{uuid}".get.operationId = "GetEventTrigger" |
.paths."/v0.9/event-trigger".post.operationId = "CreateEventTrigger" |
.paths."/v0.9/event-trigger/{uuid}".patch.operationId = "UpdateEventTrigger" |
.paths."/v0.9/event-trigger/{uuid}".delete.operationId = "DeleteEventTrigger" |

## connector-operation-type
.paths."/v0.9/connector-operation-type".get.operationId = "GetConnectorOperationTypes" |
.paths."/v0.9/connector-operation-type/{uuid}".get.operationId = "GetConnectorOperationType" |
.paths."/v0.9/connector-operation-type".post.operationId = "CreateConnectorOperationType" |
.paths."/v0.9/connector-operation-type/{uuid}".put.operationId = "UpdateConnectorOperationType" |
.paths."/v0.9/connector-operation-type/{uuid}".delete.operationId = "DeleteConnectorOperationType" |

### connector-type has incorrect tags, operationIds
.paths."/connector-type".get.tags = ["connector-type__deprecated"] |
.paths."/connector-type".post.tags = ["connector-type__deprecated"] |
.paths."/connector-type/{connectorTypeId}".get.tags = ["connector-type__deprecated"] |

# api/api-integration.go:
#      // swagger:operation POST /connector-type connector__deprecated PostConnectorType
# => PostConnectorType should be CreateConnectorType
.paths."/connector-type".post.operationId = "CreateConnectorType" |


