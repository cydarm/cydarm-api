# /connector & /connector-type endpoints moved to new api
.paths."/connector".get.deprecated = true |
.paths."/connector".post.deprecated = true |
.paths."/connector/{connectorId}".get.deprecated = true |
.paths."/connector/{connectorId}".delete.deprecated = true |
.paths."/connector/{connectorId}".put.deprecated = true |
.paths."/connector-type".get.deprecated = true |
.paths."/connector-type".post.deprecated = true |
.paths."/connector-type/{connectorTypeId}".get.deprecated = true |
.paths."/connector-type/{connectorTypeId}".put.deprecated = true |

### Cosmetic formatting fixes

# Sort tags alphabetically
(.x-tagGroups[0].tags)=(.x-tagGroups[0].tags | sort) |

# Update the API description to include this code block:
# Most API endpoints require a session token (JWT) for authentication. To obtain a session token, you can use the [POST /auth/password endpoint](#operation/doAuthWithPassword) operation
.info.description = (.info.description + "\n\nMost API endpoints require a session token (JWT) for authentication. To obtain a session token, you can use the [`POST /auth/password`](#operation/doAuthWithPassword) operation") |

# Update the POST /auth/password description to include an example of how to construct the payload, and note that the username and password must be base64 encoded.
.paths."/auth/password".post.description = (.paths."/auth/password".post.description + "\n\nUsername and Password in the json payload must be base64 encoded.\n\nFor example: If the username was `john_smith` and the password was `P@s5word!`, then the payload would need to look the like following:\n\n```json\n{\"username\":\"am9obl9zbWl0aA==\",\"password\":\"UEBzNXdvcmQh\"}\n```") |



